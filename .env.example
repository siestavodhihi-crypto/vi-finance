# Copy file này thành .env.local và điền thông tin tương ứng
# TUYỆT ĐỐI KHÔNG commit file .env.local lên Git

# --- Supabase (public anon key — bảo mật bằng RLS trên từng bảng) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Gemini API (CHỈ DÙNG PHÍA SERVER, KHÔNG CÓ TIỀN TỐ NEXT_PUBLIC_) ---
# Lấy miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
